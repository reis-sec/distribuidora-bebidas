NODE_ENV=development
PORT=3000
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=distribuidora
DB_USER=app_bebidas
DB_PASSWORD=troque-esta-senha-por-uma-forte

# Gere com: openssl rand -hex 32
